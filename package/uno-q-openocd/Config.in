config BR2_PACKAGE_UNO_Q_OPENOCD
	bool "uno-q-openocd"
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_5_10 # libgpiod2
	depends on !BR2_PACKAGE_OPENOCD
	select BR2_PACKAGE_LIBGPIOD2
	help
	  OpenOCD from git, for flashing the UNO Q's STM32U585 over
	  SWD bit-banged from the QRB2210's GPIOs.

	  Buildroot's OpenOCD 0.12.0 only supports libgpiod v1, which
	  needs the deprecated GPIO character device v1 ABI. Released
	  OpenOCD has no libgpiod v2 support yet.

	  https://openocd.org
