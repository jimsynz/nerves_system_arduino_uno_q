# U-Boot environment for Nerves on the Arduino UNO Q
#
# Saving an environment to the eMMC replaces the Arduino U-Boot fork's
# compiled-in default environment, so the defaults that matter are copied
# here. The Nerves A/B logic follows nerves_system_mangopi_mq_pro.
#
# Partitions (U-Boot numbers are hex):
#   p67 (0x43) boot A   FAT: Image, qrb2210-arduino-imola.dtb
#   p68 (0x44) boot B   FAT
#   p69        rootfs A squashfs
#   p70        rootfs B squashfs
#   p71        application data f2fs

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=scsi scan; usb start
fastboot=fastboot -l $fastboot_addr_r usb 0
ums=ums 0 mmc 0

nerves_fw_active=a

# nerves_fw_autovalidate controls whether updates are considered valid once
# applied. If set to 0, the user needs to set nerves_fw_validated to 1 in their
# application. If they don't set it before a reboot, then the previous software
# is run. If 1, then no further action needs to be taken.
nerves_fw_autovalidate=1

# nerves_fw_validated is 1 if the current boot selection is accepted. It is set
# to 1 here, since this environment is written in the factory, so it is
# implicitly valid.
nerves_fw_validated=1

# nerves_fw_booted is 0 for the first boot and 1 for all reboots after that.
# NOTE: Keep this '0' so that all new boards run a 'saveenv' to exercise the
#       code that writes back to the eMMC early on.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to partition B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to partition A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    if test ${nerves_fw_active} = "a"; then\
        setenv boot_part 43;\
        setenv root_part 69;\
    else\
        setenv boot_part 44;\
        setenv root_part 70;\
    fi

nerves_boot=\
    setenv bootargs "console=ttyMSM0,115200 root=/dev/mmcblk0p${root_part} rootfstype=squashfs ro rootwait";\
    if load mmc 0:${boot_part} ${kernel_addr_r} Image &&\
       load mmc 0:${boot_part} ${fdt_addr_r} qrb2210-arduino-imola.dtb; then\
        booti ${kernel_addr_r} - ${fdt_addr_r};\
    fi;\
    echo "Failed to boot partition ${nerves_fw_active}"

bootcmd=run nerves_init nerves_boot
